pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

function _init()
	
	ship_x = 66
	ship_y = 66
	
	shipspd=2
	u_bound=120
	l_bound=0
	
	bullet_x = 128
	bullet_y = 128
	
	bulletspd = 4
	bsprite = 0

	
	
end



function _update()
	shipvx = 0
	shipvy = 0
	
	
	--bullet_y = (bullet_y -5)%60

	if (btn(0)) shipvx = -shipspd
	if (btn(1)) shipvx = shipspd
	if (btn(2)) shipvy = -shipspd
	if (btn(3)) shipvy = shipspd
	
	if (btnp(4)) then
		
		bullet_x = ship_x
		bullet_y = ship_y-4
		bsprite = 2
		sfx(1)
	end
	
	
	if (btnp(5)) then
		
		bullet_x = ship_x
		bullet_y = ship_y-4
		bsprite = 3
		sfx(0)
	end
	
	ship_x = ship_x+shipvx
	ship_y = ship_y+shipvy
	
	bullet_y = bullet_y -bulletspd
	
	
	if ship_x > u_bound then 
		ship_x = l_bound 
	elseif ship_x < l_bound then
		ship_x=u_bound
	end
	
	if ship_y > u_bound then 
		ship_y =  l_bound
	elseif ship_y < l_bound then
		ship_y=u_bound
	end

end

function _draw()
	
	cls(0)
	spr(1,ship_x,ship_y)
 
	
	spr(bsprite,bullet_x,bullet_y)
	
	--shootup(2,64,64,6)
	 
end

function shootup(sprite,x,y,dy)
	for i=0,dy do
		spr(sprite,x,y+i)
	end
end
