pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

function _init()
	
	ship_x = 66
	ship_y = 66
	shipspd=2
	shipspr = 2
	
	u_bound=120
	l_bound=0

	
	bulletspr = 14	
	bullet_x = 128
	bullet_y = 128
	bulletspd = 4
	
	
	--bulletspr = 0
	
	thrustspr = 4
	muzzle = 0
	
	lives = 2
	score = 30000
	bombs = 2
	
	
end



function _update()
	
	--bullet_y = (bullet_y -5)%60
	
	-- ship movement
	shipvx = 0
	shipvy = 0
 shipspr = 2
	if (btn(0)) then
	 shipvx = -shipspd
	 shipspr = 1
	end
	
	if (btn(1)) then
	 shipvx = shipspd
	 shipspr = 3
	end

	if (btn(2)) shipvy = -shipspd
	if (btn(3)) shipvy = shipspd
	
	
	-- trhuster animation with sprite 4->6
	thrustspr = thrustspr+1
	if (thrustspr >6) thrustspr = 4
	
	ship_x = ship_x+shipvx
	ship_y = ship_y+shipvy
	
	-- ship_x bounds with horizontal wrap around
	if ship_x > u_bound then 
		ship_x = l_bound 
	elseif ship_x < l_bound then
		ship_x=u_bound
	end
	-- ship_y bounds without wrap around
	if ship_y > u_bound then 
		ship_y =  l_bound
	elseif ship_y < l_bound then
		ship_y=u_bound
	end
	
	--bullets
	if (btnp(4)) then
		
		bullet_x = ship_x
		bullet_y = ship_y-4
		bulletspr = 32
		muzzle = 4
		sfx(1)
	end
	
	-- bullet btn 4 animation with sprite 18->16
	bulletspr = bulletspr+0.66
	if (bulletspr >34) bulletspr = 34
	-- bullet btn 4 movement
	if (bulletspr >33) then
	bullet_y = bullet_y -bulletspd
	end
	
-- bullet btn 5 requires reworking hardcoded animation
--[[	if (btnp(5)) then
		
		bullet_x = ship_x
		bullet_y = ship_y-4
		muzzle = 5
		bulletspr = 16
		sfx(0)
		
	end
	
	]]
	
	-- bullet muzzle flash
	if (muzzle > 0) muzzle= muzzle-2

end

function _draw()
	
	cls(0)
	spr(shipspr,ship_x,ship_y)
 
	spr(thrustspr,ship_x,ship_y+9)
	spr(bulletspr,bullet_x,bullet_y)
	
	if muzzle >0 then
		circfill(ship_x+3,ship_y-3,muzzle,7)
	end
	
	print("score:"..score,45,1) 
	
	for i=1,3 do
		if i <= bombs then
			spr(11,120-i*9,1)
		else
			spr(12,120-i*9,1)
		end
	end
	
	
	for i=1,3 do
		if i <= lives then
			spr(13,1+i*9,1)
		else
			spr(14,1+i*9,1)
		end
	end
	
	
	--shootup(2,64,64,6)
	 
end
--[[
function shootup(sprite,x,y,dy)
	for i=0,dy do
		spr(sprite,x,y+i)
	end
end
]]
